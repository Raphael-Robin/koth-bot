# Copy this file to .env.prod (tournament server) and .env.test (test server).
# Each needs its own bot application, token and server IDs.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# The tournament server
GUILD_ID=
# Role whose members can use admin commands and see every team channel
ADMIN_ROLE_ID=
# Channel where the bot posts its audit log
LOG_CHANNEL_ID=
# SQLite file; /data is the mounted volume in docker-compose.yml
DB_PATH=/data/bot.db
# Albion Online game-info API (Europe server)
ALBION_API_BASE=https://gameinfo-ams.albiononline.com/api/gameinfo
